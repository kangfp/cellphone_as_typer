#!/bin/sh
# cellphone-mic 卸载前脚本（以 root 运行）
set -e

case "$1" in
    remove|deconfigure)
        if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ]; then
            UN=$(id -u "$SUDO_USER")
            runuser -u "$SUDO_USER" -- env XDG_RUNTIME_DIR=/run/user/$UN DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UN/bus \
                systemctl --user disable --now cellphone-mic.service || true
        fi
        ;;
esac

exit 0