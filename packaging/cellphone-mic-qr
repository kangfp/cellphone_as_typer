#!/usr/bin/python3
"""cellphone-mic 每用户入口：初始化配置/token，打印访问 URL 与终端二维码。

以桌面用户身份运行（无需 sudo）：
    cellphone-mic-qr            # 初始化（若需要）+ 打印 URL/二维码
    cellphone-mic-qr --rotate   # 轮换 token 并重启服务，打印新二维码
"""

import json
import os
import re
import secrets
import subprocess
import sys

sys.path.insert(0, "/usr/lib/cellphone-mic")
import qr  # noqa: E402

CFG = os.path.expanduser("~/.config/cellphone-mic/config.json")
rotate = "--rotate" in sys.argv[1:]

cfg = {"token": "", "port": 8765, "bind": "0.0.0.0", "paste_delay_ms": 150}
if os.path.exists(CFG):
    try:
        cfg.update(json.load(open(CFG, encoding="utf-8")))
    except (json.JSONDecodeError, OSError):
        pass
if rotate or not cfg.get("token"):
    cfg["token"] = secrets.token_urlsafe(16)
os.makedirs(os.path.dirname(CFG), exist_ok=True)
fd = os.open(CFG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(cfg, f, ensure_ascii=False, indent=2)

# 兜底 enable：postinst 时若图形会话未运行，enable 可能失败，这里补上
subprocess.run(["systemctl", "--user", "enable", "cellphone-mic.service"], check=False)
if rotate:
    subprocess.run(["systemctl", "--user", "restart", "cellphone-mic.service"], check=False)

out = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"],
                     capture_output=True, text=True).stdout
m = re.search(r"src ([0-9.]+)", out)
url = "http://%s:%s/?k=%s" % (m.group(1) if m else "127.0.0.1", cfg.get("port", 8765), cfg["token"])
print(url)
print(qr.terminal_str(qr.make(url)))