#!/bin/sh
# cellphone-mic 卸载后脚本（以 root 运行）
set -e

case "$1" in
    purge)
        if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ]; then
            UH=$(getent passwd "$SUDO_USER" | cut -d: -f6)
            rm -rf "$UH/.config/cellphone-mic"
            echo "cellphone-mic: 已清除 $SUDO_USER 的用户配置（token 失效）"
        fi
        ;;
    remove)
        if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ]; then
            UN=$(id -u "$SUDO_USER")
            runuser -u "$SUDO_USER" -- env XDG_RUNTIME_DIR=/run/user/$UN DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UN/bus \
                systemctl --user daemon-reload || true
        fi
        ;;
esac

exit 0