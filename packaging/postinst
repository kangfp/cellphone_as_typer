#!/bin/sh
# cellphone-as-typer 安装后脚本（以 root 运行）
set -e

case "$1" in
    configure)
        # uinput 规则立即生效（native 后端需要；headless 后端不需要）
        udevadm control --reload-rules || true
        udevadm trigger --name-match=uinput || true

        # 应用菜单入口与图标立即可见
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
        update-desktop-database /usr/share/applications >/dev/null 2>&1 || true

        if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ]; then
            UH=$(getent passwd "$SUDO_USER" | cut -d: -f6)
            UN=$(id -u "$SUDO_USER")
            RU="runuser -u $SUDO_USER -- env XDG_RUNTIME_DIR=/run/user/$UN DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UN/bus"

            # 迁移旧版 cellphone-mic（手动部署或旧 deb）：停旧服务、删旧文件、
            # 配置目录整体搬移（token 保留，手机免重配）
            $RU systemctl --user disable --now cellphone-mic.service 2>/dev/null || true
            if [ -d "$UH/.local/share/cellphone-mic" ]; then
                rm -rf "$UH/.local/share/cellphone-mic"
                echo "cellphone-as-typer: 已移除旧手动部署 ~/.local/share/cellphone-mic"
            fi
            rm -f "$UH/.config/systemd/user/cellphone-mic.service"
            if [ -d "$UH/.config/cellphone-mic" ] && [ ! -d "$UH/.config/cellphone-as-typer" ]; then
                mv "$UH/.config/cellphone-mic" "$UH/.config/cellphone-as-typer"
                echo "cellphone-as-typer: 已迁移旧配置（token 保留，手机免重配）"
            fi

            # input 组（native 后端需要；headless 后端无需）
            if ! id -nG "$SUDO_USER" | grep -qw input; then
                usermod -aG input "$SUDO_USER"
                echo "cellphone-as-typer: $SUDO_USER 已加入 input 组——native 后端需注销重登生效"
            fi

            $RU systemctl --user daemon-reload || true
            $RU systemctl --user enable cellphone-as-typer.service || true
            $RU systemctl --user restart cellphone-as-typer.service || true
            # 每用户配置/token 初始化 + 打印 URL 与终端二维码（出现在 apt 输出里）
            $RU cellphone-as-typer-qr || true
        else
            echo "cellphone-as-typer: 未检测到 SUDO_USER——请以桌面用户身份运行 cellphone-as-typer-qr 完成初始化"
        fi

        echo "cellphone-as-typer 已安装。"
        echo "  • 打开位置：应用菜单 → Cellphone As Typer（手机输入），或终端 cellphone-as-typer-qr"
        echo "  • 配对窗口含「停止服务」按钮，可按喜好随时停用/恢复"
        echo "  • 服务状态: systemctl --user status cellphone-as-typer"
        ;;
esac

exit 0